{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@fiction-map/core": ["../core/src/index.ts"]
    },
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".."
  },
  "include": ["src/**/*", "../core/src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
