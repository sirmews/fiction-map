{
  "name": "@app/literature-rpg",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:deps": "bun run --filter @fiction-map/core build && bun run --filter @fiction-map/entities build && bun run --filter @fiction-map/runtime build && bun run --filter @fiction-map/protocol build && bun run --filter fiction-map build",
    "prestart": "bun run build:deps",
    "start": "bun run src/main.ts",
    "pregenerate": "bun run build:deps",
    "generate": "bun node_modules/fiction-map/dist/cli.js generate --root-dir src",
    "prevalidate": "bun run build:deps",
    "validate": "bun node_modules/fiction-map/dist/cli.js validate --root-dir src",
    "pretest": "bun run build:deps",
    "test": "vitest run",
    "pretypecheck": "bun run build:deps",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fiction-map/core": "workspace:*",
    "@fiction-map/entities": "workspace:*",
    "@fiction-map/protocol": "workspace:*",
    "@fiction-map/runtime": "workspace:*",
    "fiction-map": "workspace:*",
    "hono": "^4.12.26"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^1.0.0"
  }
}
