          "blocks": [
            {
              "id": "armory-desc",
              "type": "paragraph",
              "text": "A dusty, long-abandoned armory. Racks of rusted weapons line the walls, but a pristine Silver Shield hangs on a central plaque."
            }
          ]
        },
